# Public application origin; no trailing slash.
APP_ORIGIN=http://127.0.0.1:5173

# Generate independent values with at least 32 random bytes each.
OTP_PEPPER=replace-with-at-least-32-random-characters
OTP_IP_PEPPER=replace-with-another-32-random-characters

# Dedicated OpenWA instance and operator-level API key. Do not use a personal WhatsApp account.
OPENWA_BASE_URL=https://openwa.example.invalid
OPENWA_API_KEY=replace-with-openwa-operator-key
OPENWA_SESSION_ID=00000000-0000-4000-8000-000000000000

# Supabase injects URL and legacy keys into hosted Edge Functions. New projects may
# instead provide SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY as secrets.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# SUPABASE_SECRET_KEY=sb_secret_replace-me
